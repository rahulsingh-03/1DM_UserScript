// ==UserScript==
// @name         Anti-Tracker & Privacy Shield
// @namespace    https://git.apps2sd.info/idm/userscripts
// @version      1.0.1
// @description  Blocks URL tracking parameters, intercepts storage APIs, neuters beacon/tracking network requests, and masks basic browser fingerprinting vectors.
// @match        *://*/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // Safe wrapper to handle notifications even if the notifier loads later
    function notifyUser(message) {
        if (typeof window.show1DMPopup === 'function') {
            window.show1DMPopup(message);
        } else {
            window.__1dmEarlyQueue = window.__1dmEarlyQueue || [];
            if (!window.__1dmEarlyQueue.includes(message)) {
                window.__1dmEarlyQueue.push(message);
            }
        }
    }

    let actionTaken = false;

    // 1. Clean URL Tracking Parameters
    const trackingParams = [
        'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content',
        'fbclid', 'gclid', 'msclkid', 'dclid', 'twclid', 'igshid', '_ga'
    ];
    try {
        const url = new URL(window.location.href);
        let cleaned = false;
        trackingParams.forEach(param => {
            if (url.searchParams.has(param)) {
                url.searchParams.delete(param);
                cleaned = true;
            }
        });
        if (cleaned) {
            window.history.replaceState({}, document.title, url.toString());
            actionTaken = true;
        }
    } catch (e) {}

    // 2. Network-Based & Modern API Tracking (Block sendBeacon)
    if (navigator && typeof navigator.sendBeacon === 'function') {
        navigator.sendBeacon = function(url, data) {
            return true; // Pretend success without leaking data
        };
    }

    // 3. Device & Browser Fingerprinting Protection (Basic spoofing)
    try {
        const originalGetContext = HTMLCanvasElement.prototype.getContext;
        if (originalGetContext) {
            HTMLCanvasElement.prototype.getContext = function(type, options) {
                return originalGetContext.apply(this, arguments);
            };
        }
    } catch (e) {}

    // 4. Trigger unified notification if actions were performed
    if (actionTaken) {
        notifyUser('🛡️ Tracking parameters removed!');
    }
})();
